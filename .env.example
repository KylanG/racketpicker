# Copy to .env.local and fill in. Never commit real values.

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (RP-13)
NEXT_PUBLIC_SUPABASE_URL=https://ghzuepngihlcyisrannm.supabase.co
# Publishable key (sb_publishable_...), safe for the browser; RLS protects the data
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...), server-only: feed imports and cron. Bypasses RLS.
SUPABASE_SECRET_KEY=
# Personal access token, only needed locally for `npm run db:types`
SUPABASE_ACCESS_TOKEN=

# Resend (RP-31)
RESEND_API_KEY=

# Affiliate feeds (RP-16, RP-17)
DAISYCON_FEED_URLS=
AWIN_API_KEY=
AWIN_PUBLISHER_ID=

# Live markets, comma-separated (RP-11). /es/ stays 404 until "nl,es".
NEXT_PUBLIC_ACTIVE_LOCALES=nl

# Copy to .env.local and fill in. Never commit real values.

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (RP-13)
NEXT_PUBLIC_SUPABASE_URL=https://ghzuepngihlcyisrannm.supabase.co
# Publishable key (sb_publishable_...), safe for the browser; RLS protects the data
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...), server-only: feed imports and cron. Bypasses RLS.
SUPABASE_SECRET_KEY=
# Postgres connection string (Dashboard → Connect), only needed locally for `npm run db:seed`
SUPABASE_DB_URL=
# Personal access token, only needed locally for `npm run db:types`
SUPABASE_ACCESS_TOKEN=

# Vercel Cron (RP-19): random string, Vercel sends it as Bearer token to /api/cron/*. Secret.
CRON_SECRET=

# Resend (RP-31)
RESEND_API_KEY=

# Affiliate feeds (RP-16, RP-17, see docs/feeds.md). JSON map shop-slug → feed URL. Secret.
DAISYCON_FEED_URLS={}
AWIN_FEED_URLS={}
AWIN_API_KEY=
AWIN_PUBLISHER_ID=3144483

# Show is_sample products (RP-15). true for Preview/Development, never for Production.
NEXT_PUBLIC_SHOW_SAMPLE_DATA=false

# Live markets, comma-separated (RP-11). /es/ stays 404 until "nl,es".
NEXT_PUBLIC_ACTIVE_LOCALES=nl

# Google Analytics 4 (RP-63). Production only; loads after consent for "Analytisch". Not a secret.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Company details (RP-36). Shown on Over ons, Privacy, Contact and in the footer once set.
# A Dutch business must show its KvK number and address on the website.
COMPANY_LEGAL_NAME=
COMPANY_KVK=
COMPANY_VAT=
COMPANY_ADDRESS=

# Contact form (RP-36). The form only appears when Resend is set up (RP-31). Server-only.
CONTACT_FROM=
CONTACT_TO=hello@racketpicker.com
